/**
 * This test checks that the compiler rejects AUTO as a remote type: [type =
 * AUTO] describes both how the data is received and what the task gets.
 */
TASK(k)

k = 0 .. 10

: A( k )

  RW A <- A(k)            [ type_remote = AUTO ]
       -> A(k)
BODY
{
    /* Nothing */
}
END
