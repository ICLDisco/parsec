#include <stdio.h>
#include "parsec/data_dist/matrix/two_dim_rectangle_cyclic.h"
#include "parsec/data_internal.h"
#include "parsec/sys/atomic.h"
#include "parsec/utils/debug.h"
#include "tests/tests_runtime.h"

/**
 * A task that only writes a flow, or asks for a NEW one, gets a copy the
 * runtime allocates for it, on a data nothing else knows about. That data
 * must go away with its last copy, which it only does when its copies hold
 * all its references: one reference more, kept for an owner that does not
 * exist, and the data is never freed.
 *
 * The tasks that receive such a copy check that its data is referenced by
 * its copies only. The task that reads both checks what was written.
 */

static int32_t nb_checked = 0;   /* copies looked at in this process */
static int32_t nb_errors  = 0;

static void check_new_copy(const char *what, int k, parsec_data_copy_t *copy)
{
    parsec_data_t *data = copy->original;
    int32_t refs = data->super.obj_reference_count, copies = data->nb_copies;

    (void)parsec_atomic_fetch_inc_int32(&nb_checked);
    if( refs != copies ) {
        fprintf(stderr, "%s(%d): the data of the new copy has %d references for %d cop%s\n",
                what, k, (int)refs, (int)copies, (1 == copies) ? "y" : "ies");
        (void)parsec_atomic_fetch_inc_int32(&nb_errors);
    }
}

%}

descA      [type = "parsec_matrix_block_cyclic_t*"]
NT         [type = int]

/* A flow the task only writes */
WRITER(k)
  k = 0 .. NT-1
: descA(k, 0)

  WRITE W -> W READER(k)

BODY
  check_new_copy("WRITER", k, this_task->data._f_W.data_in);
  ((int32_t*)W)[0] = k;
END

/* A flow that explicitly asks for a new copy */
CREATOR(k)
  k = 0 .. NT-1
: descA(k, 0)

  WRITE N <- NEW        [ type = DEFAULT ]
          -> N READER(k)

BODY
  check_new_copy("CREATOR", k, this_task->data._f_N.data_in);
  ((int32_t*)N)[0] = -k;
END

READER(k)
  k = 0 .. NT-1
: descA(k, 0)

  READ W <- W WRITER(k)
  READ N <- N CREATOR(k)

BODY
  if( (k != ((int32_t*)W)[0]) || (-k != ((int32_t*)N)[0]) ) {
    fprintf(stderr, "READER(%d): read %d and %d instead of %d and %d\n",
            k, (int)((int32_t*)W)[0], (int)((int32_t*)N)[0], k, -k);
    (void)parsec_atomic_fetch_inc_int32(&nb_errors);
  }
END

extern "C" %{

#define TILES_PER_PROCESS 16

int main(int argc, char *argv[])
{
    parsec_context_t *parsec;
    parsec_new_copy_taskpool_t *tp;
    parsec_matrix_block_cyclic_t descA;
    int rc, rank, world, NT, ret = 0;

    rc = parsec_tests_context_init(-1, PARSEC_TEST_THREAD_SERIALIZED,
                                   &argc, &argv, &parsec, &rank, &world);
    PARSEC_CHECK_ERROR(rc, "parsec_tests_context_init");

    /* The collection only places the tasks: tile (k, 0) and the three tasks
     * of index k live on process k modulo the number of processes. */
    NT = TILES_PER_PROCESS * world;
    parsec_matrix_block_cyclic_init(&descA, PARSEC_MATRIX_INTEGER, PARSEC_MATRIX_TILE,
                                    rank,
                                    1, 1,      /* Tile size */
                                    NT, 1,     /* Global matrix size */
                                    0, 0,      /* Starting point in the global matrix */
                                    NT, 1,     /* Submatrix size */
                                    world, 1,  /* process grid */
                                    1, 1,      /* k-cyclicity */
                                    0, 0);
    descA.mat = parsec_data_allocate(descA.super.nb_local_tiles *
                                     descA.super.bsiz *
                                     parsec_datadist_getsizeoftype(PARSEC_MATRIX_INTEGER));
    parsec_data_collection_set_key(&descA.super.super, "A");

    tp = parsec_new_copy_new(&descA, NT);
    /* No copy travels between processes: the datatype of the arena is not used */
    parsec_arena_datatype_set_type(&tp->arenas_datatypes[PARSEC_new_copy_DEFAULT_ADT_IDX],
                                   sizeof(int32_t), PARSEC_ARENA_ALIGNMENT_SSE,
                                   PARSEC_DATATYPE_NULL);

    rc = parsec_context_add_taskpool(parsec, (parsec_taskpool_t*)tp);
    PARSEC_CHECK_ERROR(rc, "parsec_context_add_taskpool");
    rc = parsec_context_start(parsec);
    PARSEC_CHECK_ERROR(rc, "parsec_context_start");
    rc = parsec_context_wait(parsec);
    PARSEC_CHECK_ERROR(rc, "parsec_context_wait");

    if( (2 * TILES_PER_PROCESS != nb_checked) || (0 != nb_errors) ) {
        fprintf(stderr, "Rank %d: %d new copies checked instead of %d, %d errors\n",
                rank, (int)nb_checked, 2 * TILES_PER_PROCESS, (int)nb_errors);
        ret = 1;
    } else {
        printf("Rank %d: the data of its %d new copies was referenced by its copies only\n",
               rank, (int)nb_checked);
    }

    PARSEC_OBJ_DESTRUCT(&tp->arenas_datatypes[PARSEC_new_copy_DEFAULT_ADT_IDX]);
    parsec_taskpool_free((parsec_taskpool_t*)tp);
    parsec_data_free(descA.mat);
    parsec_tiled_matrix_destroy((parsec_tiled_matrix_t*)&descA);

    rc = parsec_tests_context_fini(&parsec);
    PARSEC_CHECK_ERROR(rc, "parsec_tests_context_fini");
    return ret;
}

%}
