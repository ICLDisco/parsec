extern "C" %{
/*
 * Copyright (c) 2026
 */

/**
 * One flow sends two payloads to the same process: one received packed, the
 * other with the datatype of its only successor.
 *
 * SEND(k) sends nbytes(k) bytes (a whole number of doubles) to three tasks on
 * the same process. Two of them read the payload described as doubles, and
 * disagree on how to receive it, so it is received packed and unpacked for
 * each of them:
 *  - MODE 0: PD reads exactly the doubles sent, PB the same bytes as bytes
 *    (they disagree on the datatype);
 *  - MODE 1: AUTOD reads it with [type = AUTO layout = parsec_datatype_double_t],
 *    PAD pads it to MAX_BYTES / 8 doubles (same datatype, but an AUTO receive
 *    and a padded one cannot share a copy).
 * The third successor, X, reads the payload described as bytes, a second
 * payload of the same flow, received as it declares it, unpacked by no one.
 * ORDER lists the packed payload first (SEND) or last (SENDR).
 *
 * After the reception, the packed payload gives an unfulfilled reshape
 * promise and the other one a fulfilled one, both for the same flow of the
 * same predecessor. With the packed payload first, the unfulfilled promise
 * holds the repository entry of the predecessor when the fulfilled one comes:
 * setting it up must not trigger the reshape of the former.
 * Small payloads come in the activation message, both at once: each successor
 * must still get the copy of its own payload, with the datatype it declares.
 */

#include <assert.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "parsec.h"
#include "parsec/data_internal.h"
#include "parsec/data_dist/matrix/two_dim_rectangle_cyclic.h"
#include "tests/tests_runtime.h"

static int32_t g_errors = 0;
static int32_t g_remote = 0;

/* A whole number of doubles, spread over [8, max] */
static inline int nbytes_of(int k, int max)
{
    uint64_t h = (uint64_t)(k + 1) * 2654435761ULL;
    return 8 * (int)(1 + h % (uint64_t)(max / 8));
}

static inline uint8_t byte_of(int k, int i) { return (uint8_t)((3 * k + i) & 0xff); }

static inline int rank_of_k(parsec_matrix_block_cyclic_t *desc, int k)
{
    parsec_data_collection_t *dc = (parsec_data_collection_t*)desc;
    return (int)dc->rank_of(dc, k, 0);
}

static void check(const char *name, int k, int remote, const parsec_data_copy_t *copy,
                  const uint8_t *p, int nbytes, size_t min_span, size_t exact_span,
                  parsec_datatype_t dtt)
{
    int err = 0;
    for(int i = 0; i < nbytes; i++) {
        if( p[i] != byte_of(k - 1, i) ) {
            fprintf(stderr, "receive_packed_exact: %s(%d) wrong byte %d of %d\n", name, k, i, nbytes);
            err++;
            break;
        }
    }
    if( copy->original->span < min_span ) {
        fprintf(stderr, "receive_packed_exact: %s(%d) spans %zu bytes, less than the %zu it declares\n",
                name, k, copy->original->span, min_span);
        err++;
    }
    if( (0 != exact_span) && (copy->original->span != exact_span) ) {
        fprintf(stderr, "receive_packed_exact: %s(%d) spans %zu bytes, expected %zu\n",
                name, k, copy->original->span, exact_span);
        err++;
    }
    if( remote && (copy->dtt != dtt) ) {
        /* a received copy holds the datatype its successor receives with */
        fprintf(stderr, "receive_packed_exact: %s(%d) got a copy of another datatype\n", name, k);
        err++;
    }
    if( remote ) (void)parsec_atomic_fetch_inc_int32(&g_remote);
    if( err ) (void)parsec_atomic_fetch_add_int32(&g_errors, err);
}
%}

descA      [type = "parsec_matrix_block_cyclic_t*"]
NT         [type = int]
MAX_BYTES  [type = int]
ORDER      [type = int]
MODE       [type = int]

/* the packed payload first */
SEND(k)
k = 0 .. ((0 == ORDER) ? NT-2 : -1)
nbytes = %{ return nbytes_of(k, MAX_BYTES); %}

: descA(k, 0)

RW A <- descA(k, 0)
     -> (0 == MODE) ? A PD(k+1)     [ type_remote = DEFAULT  layout_remote = parsec_datatype_double_t  count_remote = %{ return nbytes / 8; %} ]
     -> (0 == MODE) ? A PB(k+1)     [ type_remote = DEFAULT  layout_remote = parsec_datatype_double_t  count_remote = %{ return nbytes / 8; %} ]
     -> (1 == MODE) ? A AUTOD(k+1)  [ type_remote = DEFAULT  layout_remote = parsec_datatype_double_t  count_remote = %{ return nbytes / 8; %} ]
     -> (1 == MODE) ? A PAD(k+1)    [ type_remote = DEFAULT  layout_remote = parsec_datatype_double_t  count_remote = %{ return nbytes / 8; %} ]
     -> A X(k+1)                    [ type_remote = DEFAULT  layout_remote = parsec_datatype_int8_t    count_remote = %{ return nbytes; %} ]

BODY
{
    for(int i = 0; i < nbytes; i++) ((uint8_t*)A)[i] = byte_of(k, i);
}
END

/* the packed payload last */
SENDR(k)
k = 0 .. ((0 != ORDER) ? NT-2 : -1)
nbytes = %{ return nbytes_of(k, MAX_BYTES); %}

: descA(k, 0)

RW A <- descA(k, 0)
     -> A X(k+1)                    [ type_remote = DEFAULT  layout_remote = parsec_datatype_int8_t    count_remote = %{ return nbytes; %} ]
     -> (0 == MODE) ? A PD(k+1)     [ type_remote = DEFAULT  layout_remote = parsec_datatype_double_t  count_remote = %{ return nbytes / 8; %} ]
     -> (0 == MODE) ? A PB(k+1)     [ type_remote = DEFAULT  layout_remote = parsec_datatype_double_t  count_remote = %{ return nbytes / 8; %} ]
     -> (1 == MODE) ? A AUTOD(k+1)  [ type_remote = DEFAULT  layout_remote = parsec_datatype_double_t  count_remote = %{ return nbytes / 8; %} ]
     -> (1 == MODE) ? A PAD(k+1)    [ type_remote = DEFAULT  layout_remote = parsec_datatype_double_t  count_remote = %{ return nbytes / 8; %} ]

BODY
{
    for(int i = 0; i < nbytes; i++) ((uint8_t*)A)[i] = byte_of(k, i);
}
END

PD(k)
k = 1 .. ((0 == MODE) ? NT-1 : 0)
nbytes = %{ return nbytes_of(k - 1, MAX_BYTES); %}
remote = %{ return rank_of_k(descA, k - 1) != rank_of_k(descA, k); %}

: descA(k, 0)

READ A <- (0 == ORDER) ? A SEND(k-1) : A SENDR(k-1)
          [ type_remote = DEFAULT  layout_remote = parsec_datatype_double_t
            count_remote = %{ return nbytes / 8; %} ]

BODY
{
    check("PD", k, remote, _f_A, (const uint8_t*)A, nbytes, (size_t)nbytes, 0, parsec_datatype_double_t);
}
END

PB(k)
k = 1 .. ((0 == MODE) ? NT-1 : 0)
nbytes = %{ return nbytes_of(k - 1, MAX_BYTES); %}
remote = %{ return rank_of_k(descA, k - 1) != rank_of_k(descA, k); %}

: descA(k, 0)

READ A <- (0 == ORDER) ? A SEND(k-1) : A SENDR(k-1)
          [ type_remote = DEFAULT  layout_remote = parsec_datatype_int8_t
            count_remote = %{ return nbytes; %} ]

BODY
{
    check("PB", k, remote, _f_A, (const uint8_t*)A, nbytes, (size_t)nbytes, 0, parsec_datatype_int8_t);
}
END

AUTOD(k)
k = 1 .. ((1 == MODE) ? NT-1 : 0)
nbytes = %{ return nbytes_of(k - 1, MAX_BYTES); %}
remote = %{ return rank_of_k(descA, k - 1) != rank_of_k(descA, k); %}

: descA(k, 0)

READ A <- (0 == ORDER) ? A SEND(k-1) : A SENDR(k-1)  [ type = AUTO  layout = parsec_datatype_double_t ]

BODY
{
    check("AUTOD", k, remote, _f_A, (const uint8_t*)A, nbytes, 0, remote ? (size_t)nbytes : 0, parsec_datatype_double_t);
}
END

PAD(k)
k = 1 .. ((1 == MODE) ? NT-1 : 0)
nbytes = %{ return nbytes_of(k - 1, MAX_BYTES); %}
remote = %{ return rank_of_k(descA, k - 1) != rank_of_k(descA, k); %}

: descA(k, 0)

READ A <- (0 == ORDER) ? A SEND(k-1) : A SENDR(k-1)
          [ type_remote = DEFAULT  layout_remote = parsec_datatype_double_t
            count_remote = %{ return MAX_BYTES / 8; %} ]

BODY
{
    check("PAD", k, remote, _f_A, (const uint8_t*)A, nbytes, (size_t)MAX_BYTES, 0, parsec_datatype_double_t);
}
END

X(k)
k = 1 .. NT-1
nbytes = %{ return nbytes_of(k - 1, MAX_BYTES); %}
remote = %{ return rank_of_k(descA, k - 1) != rank_of_k(descA, k); %}

: descA(k, 0)

READ A <- (0 == ORDER) ? A SEND(k-1) : A SENDR(k-1)
          [ type_remote = DEFAULT  layout_remote = parsec_datatype_int8_t
            count_remote = %{ return nbytes; %} ]

BODY
{
    check("X", k, remote, _f_A, (const uint8_t*)A, nbytes, (size_t)nbytes, 0, parsec_datatype_int8_t);
}
END

extern "C" %{
int main(int argc, char **argv)
{
    parsec_context_t *parsec = NULL;
    parsec_receive_packed_exact_taskpool_t *tp;
    parsec_matrix_block_cyclic_t descA;
    parsec_arena_datatype_t *adt = PARSEC_OBJ_NEW(parsec_arena_datatype_t);
    int rank = 0, world = 1, nt = 32, max_bytes = 4096, rc;
    int32_t local[2], global[2];
    int pargc = 0;
    char **pargv = NULL;

    for(int i = 1; i < argc; i++) {
        if( 0 == strcmp(argv[i], "--") ) {
            pargc = argc - i;
            pargv = argv + i;
            break;
        }
        if( 0 == strncmp(argv[i], "-n=", 3) ) {
            nt = (int)strtol(argv[i] + 3, NULL, 10);
            continue;
        }
        if( 0 == strncmp(argv[i], "-b=", 3) ) {
            max_bytes = (int)strtol(argv[i] + 3, NULL, 10);
            continue;
        }
    }
    if( nt < 2 ) nt = 2;
    if( max_bytes < 16 ) max_bytes = 16;
    max_bytes &= ~7;  /* a whole number of doubles */

    rc = parsec_tests_context_init(-1, PARSEC_TEST_THREAD_SERIALIZED, &pargc, &pargv,
                                   &parsec, &rank, &world);
    PARSEC_CHECK_ERROR(rc, "parsec_tests_context_init");

    parsec_matrix_block_cyclic_init(&descA, PARSEC_MATRIX_BYTE, PARSEC_MATRIX_TILE,
                                    rank, max_bytes, 1, nt * max_bytes, 1,
                                    0, 0, nt * max_bytes, 1,
                                    world, 1, 1, 1, 0, 0);
    descA.mat = parsec_data_allocate((size_t)descA.super.nb_local_tiles *
                                     (size_t)descA.super.bsiz *
                                     parsec_datadist_getsizeoftype(PARSEC_MATRIX_BYTE));
    rc = parsec_matrix_adt_define_rect(adt, parsec_datatype_int8_t, max_bytes, 1, max_bytes);
    PARSEC_CHECK_ERROR(rc, "parsec_matrix_adt_define_rect");

    for(int mode = 0; mode < 2; mode++) {
        for(int order = 0; order < 2; order++) {
            tp = parsec_receive_packed_exact_new(&descA, nt, max_bytes, order, mode);
            assert(NULL != tp);
            tp->arenas_datatypes[PARSEC_receive_packed_exact_DEFAULT_ADT_IDX] = *adt;
            rc = parsec_context_add_taskpool(parsec, &tp->super);
            PARSEC_CHECK_ERROR(rc, "parsec_context_add_taskpool");
            rc = parsec_context_start(parsec);
            PARSEC_CHECK_ERROR(rc, "parsec_context_start");
            rc = parsec_context_wait(parsec);
            PARSEC_CHECK_ERROR(rc, "parsec_context_wait");
            parsec_taskpool_free(&tp->super);
        }
    }

    local[0] = g_errors;
    local[1] = g_remote;
    rc = parsec_tests_allreduce(parsec, local, global, 2, parsec_datatype_int32_t,
                                PARSEC_TESTS_REDUCE_SUM);
    PARSEC_CHECK_ERROR(rc, "parsec_tests_allreduce");

    parsec_matrix_adt_free(&adt);
    parsec_data_free(descA.mat);
    parsec_tiled_matrix_destroy((parsec_tiled_matrix_t*)&descA);
    rc = parsec_tests_context_fini(&parsec);
    PARSEC_CHECK_ERROR(rc, "parsec_tests_context_fini");

    if( 0 != global[0] ) {
        fprintf(stderr, "receive_packed_exact: FAILED (%d errors)\n", global[0]);
        return EXIT_FAILURE;
    }
    if( (world > 1) && (0 == global[1]) ) {
        fprintf(stderr, "receive_packed_exact: FAILED (no data received from another process)\n");
        return EXIT_FAILURE;
    }
    if( 0 == rank ) {
        printf("receive_packed_exact: PASS (nt=%d, max_bytes=%d, processes=%d, remote receptions=%d)\n",
               nt, max_bytes, world, global[1]);
    }
    return EXIT_SUCCESS;
}
%}
